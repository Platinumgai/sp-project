# Environment file for `docker compose up` -- Compose reads a `.env` file
# from THIS directory (next to docker-compose.yml) to fill in ${VAR}
# placeholders. Copy this to `.env` and fill in real values; never commit
# the real `.env`.
#
# For running the backend directly (outside Docker), see
# backend/.env.example instead -- these are two separate files because
# Docker Compose and a plain `uvicorn` process read their environment
# from different places.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# development | production -- see backend/.env.example for what each does.
ENVIRONMENT=development

# The origin the React frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173
